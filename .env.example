# Developer runtime settings. Copy to .env only after the infrastructure and
# tool handoffs in infra/docs/application-flow.md. Fill verified runtime values.

# AI Gateway is the model and tool front door for this sample.
AZURE_AI_GATEWAY_ENDPOINT="https://<gateway-host-name>/"
# MCP clients use this URL and send AZURE_AI_GATEWAY_API_KEY in the Api-Key header.
AZURE_AI_GATEWAY_GITHUB_MCP_ENDPOINT="https://<gateway-host-name>/default/toolservers/github/mcp"
# Leave empty for your existing Entra login; it needs the gateway Models User role.
# Set a separately selected runtime key only when deliberately using API-key auth.
AZURE_AI_GATEWAY_API_KEY=""
AZURE_AI_GATEWAY_MODEL="gpt-latest"
AZURE_AI_GATEWAY_MINI_MODEL="gpt-mini-latest"

# Use the versioned Toolbox endpoint and name from the verified tool receipt.
TOOLBOX_ENDPOINT="https://<foundry-host-name>/api/projects/<project-name>/toolboxes/repo-digest-tools/versions/<version>/mcp?api-version=v1"
TOOLBOX_NAME="repo-digest-tools"

# GitHub repository used when the request does not name one.
GITHUB_REPOSITORY="<owner>/<repository>"
